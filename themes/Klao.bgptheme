override_git_prompt_colors() {
  GIT_PROMPT_THEME_NAME="Klao"

  function prompt_callback {
    local PS1="\u@\h: $(gp_truncate_pwd)"
    gp_set_window_title "$PS1"
  }

  Time12a="\$(date +%H:%M:%S)"

  GIT_PROMPT_PREFIX="["
  GIT_PROMPT_SUFFIX="]"
  GIT_PROMPT_SEPARATOR=""
  GIT_PROMPT_STAGED=" ${Green}●${ResetColor}"
  GIT_PROMPT_CONFLICTS=" ${Red}✖${ResetColor}"
  GIT_PROMPT_CHANGED=" ${Yellow}✚${ResetColor}"
  GIT_PROMPT_UNTRACKED=" ${Cyan}…${ResetColor}"
  GIT_PROMPT_STASHED=" ${BoldBlue}⚑${ResetColor}"
  GIT_PROMPT_CLEAN=" ${BoldGreen}✔${ResetColor}"

  GIT_PROMPT_COMMAND_OK="${Green}✔"
  GIT_PROMPT_COMMAND_FAIL="${Red}✘ _LAST_COMMAND_STATE_"

  GIT_PROMPT_START_USER="${NewLine}_LAST_COMMAND_INDICATOR_${ResetColor} \h ${Cyan}${PathShort}${ResetColor}"
  GIT_PROMPT_END_USER="\n${Blue}${Time12a}${ResetColor} $ "

  GIT_PROMPT_MASTER_BRANCH="${White}"
}

reload_git_prompt_colors "Klao"
